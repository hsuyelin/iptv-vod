# Copy to .env and edit. `docker compose up -d` reads it automatically.

# Published image
IPTV_IMAGE=hsuyelin/iptv-vod:latest

# Container
IPTV_CONTAINER_NAME=iptv-vod
IPTV_HOSTNAME=iptv-vod
RESTART_POLICY=unless-stopped
NOFILE_LIMIT=65536
TZ=Asia/Shanghai
SERVICE_NETWORK_NAME=service_net
IPTV_IPV4_ADDRESS=172.28.0.50

# Published address: the console and the playlist (http://<host>:<port>/list.m3u)
# Use 0.0.0.0 to reach it from other machines, 127.0.0.1 behind a reverse proxy.
BIND_HOST=127.0.0.1
IPTV_HOST_PORT=8787

# Channel list on the host, mounted read-only and reloaded without a restart
IPTV_CHANNELS_FILE=./mounts/data/app/channels.yaml

# Administrator key: 12 or more letters, digits, - or _. Leave empty to generate one at
# every start (printed once in `docker compose logs`).
IPTV_ADMIN_KEY=

# Lighter stream for old iPhones and iPads (iOS before 16): 720p, no B-frames. The image ships
# the ffmpeg it needs and offers it by default; set off to switch it off.
IPTV_COMPAT=on

# Log filter: info, debug, trace, or a RUST_LOG expression such as iptv_upstream=trace,warn
RUST_LOG=info

# Health check
IPTV_HEALTH_INTERVAL=30s
IPTV_HEALTH_TIMEOUT=5s
IPTV_HEALTH_RETRIES=3
IPTV_HEALTH_START_PERIOD=15s

# Log rotation
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
